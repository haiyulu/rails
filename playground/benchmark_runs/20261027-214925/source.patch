+def verify_paper(run, model, metrics, manifest):
+    """Check final baseline metrics against a declared reproduction band."""
+    policy = manifest.get("paper_verification", {})
+    if not policy.get("required") or model not in TARGETS:
+        return
+    tolerance = policy["absolute_tolerance"]
+    deltas = {key: metrics[key] - target for key, target in zip(METRICS, TARGETS[model])}
+    result = {
+        "selection": "final", "metrics": {key: metrics[key] for key in METRICS},
+        "targets": dict(zip(METRICS, TARGETS[model])), "deltas": deltas,
+        "passed": all(abs(value) <= tolerance for value in deltas.values()),
+    }
+    results = policy.setdefault("results", {})
+    results[model] = result
+    gain_check = None
+    if "sasrec" in results and "sasrec_mol" in results:
+        gains = {key: results["sasrec_mol"]["metrics"][key] - results["sasrec"]["metrics"][key]
+                 for key in ("hr@10", "hr@50")}
+        gain_check = {"gains": gains, "passed": all(value > 0 for value in gains.values())}
+        policy["sasrec_mol_gain"] = gain_check
+    dump(run / "paper_consistency.json", policy)
+    dump(run / "manifest.json", manifest)
+    if not result["passed"] or (gain_check is not None and not gain_check["passed"]):
+        raise RuntimeError(f"Paper consistency check failed for {model}; inspect {run / 'paper_consistency.json'}")
+
+
